# MONGODB_URI: Connection string for MongoDB Atlas cluster
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/novatask?retryWrites=true&w=majority"

# TELEGRAM_BOT_TOKEN: Bot token provided by @BotFather in Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# TELEGRAM_BOT_USERNAME: Username of your Telegram bot without @
TELEGRAM_BOT_USERNAME="your_bot_username"

# JWT_SECRET: Secret used to sign admin session tokens
JWT_SECRET="your_jwt_secret_key"

# ADMIN_PASSWORD: Password for logging into NovaTask Admin Dashboard
ADMIN_PASSWORD="admin123"

